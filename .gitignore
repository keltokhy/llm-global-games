__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env

# LaTeX intermediates
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.fdb_latexmk
*.fls
*.nav
*.snm
*.toc

# LaTeX build artifacts (not the PDFs themselves)
paper/*.synctex.gz

# Calibration raw data (large)
output/**/*_raw.csv
output/**/*_history.csv

# Experiment A/B LLM response caches and rewrite caches (large, regenerable)
output/.llm_cache_*/
output/expA-cache/
output/**/rewrite_cache.json

# Experiment A/B full logs (large; per-cell joins kept in analysis/exp_ab_cell_joins.csv)
output/expA-*/**/experiment_comm_log.json
output/expB-*/**/experiment_comm_log.json
output/expA-*/*_log.json
output/expB-*/*_log.json

# Prevent loose files at output/ root
output/*.png
output/*.pdf
output/*.txt

# Archives
*.zip

# OS
.DS_Store

# uv
uv.lock

# LaTeX style files (vendored)
paper/placeins.sty
paper/multirow.sty

# Paper website prototypes (separate deployment)
paper/website/

# Claude Code worktrees and local state
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Scratch rebuild workspace (not part of canonical source tree)
REBUILD/

# Issue #109 surveillance-robustness raw logs (large; regenerable via run commands).
# Compact per-cell cells.csv files are committed for reproducibility of the stats.
output/temp-robustness/**/experiment_comm_log.json
output/temp-robustness/**/experiment_comm_summary.csv
output/structural-framing/**/experiment_comm_log.json
output/structural-framing/**/experiment_comm_summary.csv
output/_smoke/

# Local scratch / LLM caches (never commit)
tmp/
